# Public deployment variable in GitHub Actions, or pass to npm run release.
ENQUIRY_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/functions/v1/enquiries
# Edge Function secrets. Set in Supabase ONLY. The managed platform supplies SUPABASE_URL and its service key.
ALLOWED_ORIGINS=https://legacysearch.in,https://www.legacysearch.in
ENQUIRY_HMAC_SECRET=
# Optional email notifications. Sender must be verified in Resend.
RESEND_API_KEY=
LEAD_NOTIFY_FROM=
LEAD_NOTIFY_TO=

